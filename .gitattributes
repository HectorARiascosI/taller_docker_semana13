# Normaliza finales de linea: el repositorio guarda LF y el checkout usa lo nativo.
* text=auto eol=lf

# Scripts y config que corren dentro de contenedores Linux: siempre LF.
*.sh         text eol=lf
Dockerfile   text eol=lf
*.properties text eol=lf
*.xml        text eol=lf
*.md         text eol=lf
*.log        text eol=lf

# Binarios: nunca normalizar.
*.pdf  binary
*.jar  binary
*.png  binary
*.jpg  binary
